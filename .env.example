# Copy this file to .env.local and fill in values from your Supabase project
# (Supabase dashboard > Project Settings > API Keys).
# Never commit .env.local. It is ignored by git.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "publishable" key (starts with sb_publishable_) or the legacy "anon" key.
# Safe for the browser because row-level security only allows reading buildings.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Demo mode shows a "sample data" banner and hides the site from search engines.
# Leave unset (on) while building data is made up. Set to "off" once data is real.
# NEXT_PUBLIC_DEMO_MODE=off

# Typical weekday drive-time chart (TomTom Routing API, free monthly allowance).
# Server only: do NOT add NEXT_PUBLIC_ in front. Leave unset to hide the chart.
# Read TomTom's terms first: we do not store its results in our database.
# TOMTOM_API_KEY=your-tomtom-key

# Where privacy questions go. Shown on the Privacy page. Add before launch.
# NEXT_PUBLIC_CONTACT_EMAIL=help@example.com
