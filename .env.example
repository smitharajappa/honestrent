# Copy this file to .env.local and fill in values from your Supabase project
# (Supabase dashboard > Project Settings > API Keys).
# Never commit .env.local. It is ignored by git.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "publishable" key (starts with sb_publishable_) or the legacy "anon" key.
# Safe for the browser because row-level security only allows reading buildings.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
